[Unit]
Description=Ngaji
After=network.target

[Service]
Type=simple
User=ngaji
Group=ngaji
WorkingDirectory=/opt/ngaji
# .env in WorkingDirectory is read by Next.js itself (DATABASE_URL, AUTH_SECRET, AUTH_TRUST_HOST).
Environment=NODE_ENV=production
ExecStart=/usr/bin/pnpm start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/ngaji /var/backups/ngaji

[Install]
WantedBy=multi-user.target
