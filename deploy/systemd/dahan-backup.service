[Unit]
Description=Dahan encrypted offsite database backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=dahan
Group=dahan
# BACKUP_BUCKET, AGE_RECIPIENT, HEALTHCHECK_URL (see deploy/env/backup.env.example)
EnvironmentFile=/etc/dahan/backup.env
ExecStart=/opt/dahan/scripts/backup.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# sqlite3 .backup needs write access to the -shm file next to the live database.
ReadWritePaths=/var/lib/dahan /var/backups/dahan
