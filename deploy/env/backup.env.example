# Copy to /etc/ngaji/backup.env (owner root:ngaji, mode 640 or ngaji:ngaji mode 600). Never commit the real file.
# rclone remote name is "idch"; its config lives in ~ngaji/.config/rclone/rclone.conf (see deploy/rclone.conf.example).

# Object Storage bucket used for backups (the bucket name only, no "idch:" prefix)
BACKUP_BUCKET=ngaji-backup-CHANGE-ME

# PUBLIC age recipient (starts with "age1..."). The matching private key stays OFF the server.
AGE_RECIPIENT=age1CHANGE_ME

# healthchecks.io ping URL (contains no PII). The script appends /fail on errors.
HEALTHCHECK_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000

# Optional overrides
# DB_PATH=/var/lib/ngaji/production.db
# LOCAL_BACKUP_DIR=/var/backups/ngaji
