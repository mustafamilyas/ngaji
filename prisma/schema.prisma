// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// SQLite has no native `enum` type, so domain enums below are plain String
// columns. Valid values are TS unions + zod schemas in lib/validation/*,
// not enforced by the database. See DESIGN.md §2.
//   Role             = "OWNER" | "ADMIN" | "USER"
//   Sex              = "L" | "P"
//   MaritalStatus    = "BELUM_MENIKAH" | "MENIKAH" | "CERAI_HIDUP" | "CERAI_MATI"
//   WorkStatus       = "BEKERJA" | "TIDAK_BEKERJA" | "PELAJAR_SD" | "PELAJAR_SMP"
//                    | "PELAJAR_SMA" | "MAHASISWA" | "IBU_RUMAH_TANGGA" | "PENSIUN"
//   MemberStatus     = "AKTIF" | "KELUAR" | "PINDAH" | "MENINGGAL"
//   Freq             = "ONCE" | "DAILY" | "WEEKLY" | "MONTHLY"
//   OccurrenceStatus = "SCHEDULED" | "CANCELLED"
//   AttendanceStatus = "HADIR" | "IZIN"
//   QuestionType     = "SINGLE_CHOICE" | "MULTI_CHOICE" | "NUMBER" | "SCALE"
//                    | "SHORT_TEXT" | "LONG_TEXT"

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  timezone  String   @default("Asia/Jakarta")
  logoUrl   String? // reserved; no upload or rendering yet
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  levels    Level[]
  groups    Group[]
}

/// Public sign-up interest from a prospective organization. Deliberately has
/// no relation to Organization: it must never surface in any org's pages or
/// audit viewer. Read only via `pnpm leads`.
model InterestLead {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String
  organizationName String
  memberCount      Int?
  message          String?
  consentAt        DateTime
  ip               String?
  userAgent        String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

/// Level name, depth 0 = root. Renaming a level is a single-row update.
model Level {
  id             Int          @id @default(autoincrement())
  organizationId Int
  depth          Int
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, depth])
}

model Group {
  id             Int       @id @default(autoincrement())
  organizationId Int
  parentId       Int?
  depth          Int // must equal parent.depth + 1
  name           String // unique among non-deleted siblings (checked in app)
  path           String // materialized path incl. own id, trailing slash: "1/5/12/"
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  parent       Group?          @relation("tree", fields: [parentId], references: [id])
  children     Group[]         @relation("tree")
  members      Member[]
  activities   Activity[]
  surveys      Survey[]
  memberViews  MemberView[]
  tags         Tag[]
  userRoles    UserGroupRole[]
  extraRoles   UserExtraRole[]

  @@index([path])
  @@index([parentId])
}

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  passwordHash       String
  name               String
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false) // true after seed & after reset by admin/owner
  sessionVersion     Int      @default(0) // bumped on password change/reset; a JWT with another value is revoked
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  role               UserGroupRole?
  extraRoles         UserExtraRole[]
  createdMembers     Member[]         @relation("memberCreatedBy")
  createdActivities  Activity[]       @relation("activityCreatedBy")
  recordedAttendance Attendance[]     @relation("attendanceRecordedBy")
  createdSurveys     Survey[]         @relation("surveyCreatedBy")
  ownedMemberViews   MemberView[]     @relation("memberViewOwner")
  createdMemberViews MemberView[]     @relation("memberViewCreatedBy")
  recordedSurveys    SurveyResponse[] @relation("surveyResponseRecordedBy")
  createdTags        Tag[]            @relation("tagCreatedBy")
  memberTags         MemberTag[]      @relation("memberTagCreatedBy")
  activityTags       ActivityTag[]    @relation("activityTagCreatedBy")
  auditLogs          AuditLog[]
}

/// MVP: @@unique([userId]). Non-MVP multi-role = drop this unique constraint only.
model UserGroupRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  groupId   Int
  role      String // Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

/// Additional ADMIN role at a group strictly below the user's primary `UserGroupRole` group (DESIGN.md §3.2a).
/// Scope never comes from here: it stays the primary role's scope.
model UserExtraRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  groupId   Int
  role      String // Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId])
  @@index([groupId])
}

model Member {
  id            Int       @id @default(autoincrement())
  groupId       Int // must be a leaf group
  name          String
  birthPlace    String
  birthDate     String // YYYY-MM-DD
  sex           String // Sex
  address       String
  phone         String? // optional; NOT unique (one phone can serve a whole family)
  maritalStatus String // MaritalStatus
  workStatus    String // WorkStatus
  email         String?
  status        String    @default("AKTIF") // MemberStatus
  joinedAt      String // YYYY-MM-DD; defaults to today on input, used in statistics
  exitedAt      String? // YYYY-MM-DD; required when status != AKTIF
  deletedAt     DateTime? // soft delete (data entry mistake); distinct from status KELUAR
  createdById   Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  group           Group            @relation(fields: [groupId], references: [id])
  createdBy       User             @relation("memberCreatedBy", fields: [createdById], references: [id])
  attendances     Attendance[]
  surveyResponses SurveyResponse[]
  tags            MemberTag[]

  @@index([groupId, status])
  @@index([name])
}

/// Activity template. Owned by one group; automatically applies to all its descendants.
model Activity {
  id              Int       @id @default(autoincrement())
  groupId         Int
  name            String
  location        String
  notes           String?
  startTime       String // "HH:mm" organization-local time
  durationMinutes Int // startTime + duration <= 24:00 (never crosses midnight)
  freq            String // Freq
  interval        Int       @default(1) // every N days/weeks/months
  weekdays        Json // number[] (WEEKLY: 0=Sunday..6=Saturday, at least 1); SQLite has no scalar list, stored as a JSON array
  monthDay        Int? // MONTHLY: day 1..31
  startsOn        String // YYYY-MM-DD
  endsOn          String? // YYYY-MM-DD; null = no end; ONCE: = startsOn; >= startsOn
  continuesFromId Int? // set when this activity resulted from "move this and following" (§5.5)
  createdById     Int
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  group         Group                @relation(fields: [groupId], references: [id])
  createdBy     User                 @relation("activityCreatedBy", fields: [createdById], references: [id])
  continuesFrom Activity?            @relation("split", fields: [continuesFromId], references: [id])
  continuedBy   Activity[]           @relation("split")
  occurrences   ActivityOccurrence[]
  tags          ActivityTag[]

  @@index([groupId])
}

/// Created lazily: only when attendance is recorded or an override (cancel / move / change time / location) is made.
/// `date` = the rule's canonical date (key). Effective date = overrideDate ?? date.
model ActivityOccurrence {
  id                      Int      @id @default(autoincrement())
  activityId              Int
  date                    String // YYYY-MM-DD
  status                  String   @default("SCHEDULED") // OccurrenceStatus
  overrideDate            String? // YYYY-MM-DD; "move once" to another date
  overrideStartTime       String?
  overrideDurationMinutes Int?
  overrideLocation        String?
  overrideNotes           String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  activity    Activity     @relation(fields: [activityId], references: [id])
  attendances Attendance[]

  @@unique([activityId, date])
  @@index([activityId, overrideDate])
}

model Attendance {
  id           Int      @id @default(autoincrement())
  occurrenceId Int
  memberId     Int
  status       String // AttendanceStatus
  note         String? // reason, only for IZIN
  recordedById Int
  recordedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  occurrence ActivityOccurrence @relation(fields: [occurrenceId], references: [id])
  member     Member             @relation(fields: [memberId], references: [id])
  recordedBy User               @relation("attendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([occurrenceId, memberId])
  @@index([memberId])
}

/// Survey form. Owned by one group; applies to all its descendants (same inheritance as Activity).
model Survey {
  id          Int       @id @default(autoincrement())
  groupId     Int
  title       String
  description String?
  createdById Int
  deletedAt   DateTime? // soft delete; questions, responses and answers are kept
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group     Group            @relation(fields: [groupId], references: [id])
  createdBy User             @relation("surveyCreatedBy", fields: [createdById], references: [id])
  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@index([groupId])
}

/// Saved member query owned by one group; visible to that exact group only (not its ancestors/descendants).
model MemberView {
  id          Int       @id @default(autoincrement())
  groupId     Int
  ownerId     Int // may differ from createdById after a takeover
  createdById Int
  name        String // unique among non-deleted views of the group, case-insensitive (checked in app)
  source      String    @default("member") // ViewSource
  visibility  String    @default("GROUP") // ViewVisibility
  definition  Json // validated by lib/validation/member-view.ts on every save and load
  deletedAt   DateTime? // soft delete
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group     Group @relation(fields: [groupId], references: [id])
  owner     User  @relation("memberViewOwner", fields: [ownerId], references: [id])
  createdBy User  @relation("memberViewCreatedBy", fields: [createdById], references: [id])

  @@index([groupId, deletedAt])
}

/// Locked once answered (type, scale range, hard delete): the lock is derived from SurveyAnswer rows, not stored.
model SurveyQuestion {
  id         Int       @id @default(autoincrement())
  surveyId   Int
  order      Int
  type       String // QuestionType
  label      String
  helpText   String?
  required   Boolean   @default(false)
  scaleMin   Int? // SCALE only
  scaleMax   Int? // SCALE only; scaleMin < scaleMax, at most 11 steps
  archivedAt DateTime? // hidden from the entry form, kept in results
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  survey  Survey         @relation(fields: [surveyId], references: [id])
  options SurveyOption[]
  answers SurveyAnswer[]

  @@index([surveyId, order])
}

/// Choice option with a stable id so renames relabel history and archiving keeps counts.
model SurveyOption {
  id         Int       @id @default(autoincrement())
  questionId Int
  order      Int
  label      String
  archivedAt DateTime?

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  SurveyAnswer[]

  @@index([questionId, order])
}

/// At most one per member per survey; saving again overwrites.
model SurveyResponse {
  id           Int      @id @default(autoincrement())
  surveyId     Int
  memberId     Int
  recordedById Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  survey     Survey         @relation(fields: [surveyId], references: [id])
  member     Member         @relation(fields: [memberId], references: [id])
  recordedBy User           @relation("surveyResponseRecordedBy", fields: [recordedById], references: [id])
  answers    SurveyAnswer[]

  @@unique([surveyId, memberId])
  @@index([memberId])
}

/// One row per answered question; MULTI_CHOICE has one row per selected option.
/// Exactly one of optionId / numberValue / textValue is set, according to the question type.
model SurveyAnswer {
  id          Int     @id @default(autoincrement())
  responseId  Int
  questionId  Int
  optionId    Int?
  numberValue Float?
  textValue   String?

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id])
  option   SurveyOption?  @relation(fields: [optionId], references: [id])

  @@index([responseId])
  @@index([questionId, optionId])
}

/// Group-owned tag (DESIGN.md §13). One row = one simple tag (value null) or one value of a key.
/// A key is the set of rows sharing (groupId, key) with a value; it has no row of its own.
/// Soft delete: every query needs `deletedAt: null`.
model Tag {
  id          Int       @id @default(autoincrement())
  groupId     Int // owner = creator's group, never from the client
  key         String // trimmed, lowercased
  value       String? // null = simple tag
  color       String // TagColor (TAG_COLORS in lib/constants.ts)
  createdById Int
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  group      Group         @relation(fields: [groupId], references: [id])
  createdBy  User          @relation("tagCreatedBy", fields: [createdById], references: [id])
  members    MemberTag[]
  activities ActivityTag[]

  @@index([groupId, deletedAt])
  @@index([key])
}

/// Tag ↔ member link. Hard-deleted (like Attendance); every attach/detach is audited.
model MemberTag {
  memberId    Int
  tagId       Int
  createdById Int
  createdAt   DateTime @default(now())

  member    Member @relation(fields: [memberId], references: [id])
  tag       Tag    @relation(fields: [tagId], references: [id])
  createdBy User   @relation("memberTagCreatedBy", fields: [createdById], references: [id])

  @@id([memberId, tagId])
  @@index([tagId])
}

/// Tag ↔ activity link. Hard-deleted; every attach/detach is audited.
model ActivityTag {
  activityId  Int
  tagId       Int
  createdById Int
  createdAt   DateTime @default(now())

  activity  Activity @relation(fields: [activityId], references: [id])
  tag       Tag      @relation(fields: [tagId], references: [id])
  createdBy User     @relation("activityTagCreatedBy", fields: [createdById], references: [id])

  @@id([activityId, tagId])
  @@index([tagId])
}

/// Audit trail. Written in the same transaction as its mutation. Append-only (no update/delete).
model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int? // null for a failed login with an unknown username
  action    String // "member.create", "attendance.save", "auth.login_failed", ...
  entity    String? // "Member", "Activity", ...
  entityId  Int?
  groupId   Int? // related group; used to scope-filter the audit viewer
  before    Json? // snapshot before (sensitive fields redacted, see §4.4)
  after     Json? // snapshot after
  meta      Json? // e.g. { username } on failed login, { memberIds } on attendance
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([groupId, createdAt])
  @@index([action, createdAt])
}
